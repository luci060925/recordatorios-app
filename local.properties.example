## Copiar este archivo como "local.properties" (en la raiz del proyecto) y completar.
## local.properties NO se sube al repositorio. Android Studio agrega solo "sdk.dir".

# Ruta del Android SDK (Android Studio la completa automaticamente).
# sdk.dir=C\:\\Users\\USUARIO\\AppData\\Local\\Android\\Sdk

# URL base del servicio remoto. Debe terminar con "/".
# Si no se define, se usa un valor de ejemplo.
API_BASE_URL=https://api.recordatorios.example.org/

# true  -> usa el servicio simulado incluido en la app (no necesita red ni servidor)
# false -> consume la URL real indicada en API_BASE_URL
USAR_SERVICIO_SIMULADO=true
